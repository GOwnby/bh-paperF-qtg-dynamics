# LaTeX build products (main.bbl is shipped)
*.aux
*.blg
*.out
*.toc
*.fdb_latexmk
*.fls
*.synctex.gz
/main.log
/texput.log
# Python
__pycache__/
*.pyc
*.pyo
# compiled libraries (built by code/build.sh and code/eh_qtg/setup.sh)
*.so
*.o
# outputs of code/eh_qtg/run_analysis.sh (default OUT=rerun_logs)
rerun_logs/
# probe files and editor/OS leftovers
.wtest
.DS_Store
Thumbs.db
/main.pdf

# verify.py / verify.sh working files (regenerated by every run; verification/logs, REPORT.md, expected.json are kept)
verification/work/
verification/rerun/
*.npy.tmp
# large regenerated arrays of the verification jobs
mech_vb_B*.npz
prof2_*.npy
blow_h*.npy
kst_*.npy

# unpacked by code/eh_qtg/codec/restore_archive.sh from archive/paperF_pulse_scan_data (the archive is the tracked copy)
/code/eh_qtg/codec/sc/pt_P*.npz
/code/eh_qtg/codec/sc/genc_*.json
/code/eh_qtg/codec/sp/*.npz
/code/eh_qtg/codec/sp/genc_*.json
# small work files of the verification jobs
/verification/figures/*.pdf

# empty placeholders left where a mounted folder does not allow deleting
/verification/logs/*.tmp
